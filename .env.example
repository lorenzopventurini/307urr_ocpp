# Copy to .env and fill in real values — never commit .env

# Easee Cloud credentials
EASEE_USERNAME=your@email.com
EASEE_PASSWORD=yourpassword

# Charger configuration
EASEE_CHARGER_SERIAL=ECXXXXXXX

# Easee site/circuit IDs (discover by running scripts/discover_easee.py)
EASEE_SITE_ID=
EASEE_CIRCUIT_ID=

# Site electrical limits (use Easee circuit ratedCurrent, not raw fuse rating)
SITE_CIRCUIT_LIMIT_AMPS=25
SITE_PHASES=3

# Tariff (pence/kWh, VAT-inclusive)
TARIFF_FLAT_PRICE_PENCE=25.0
TARIFF_INTERVAL_MINUTES=60

# Billing
BILLING_TIMEZONE=Europe/London

# Email delivery (only needed for --email)
# Gmail: smtp.gmail.com / 587 / starttls, and SMTP_PASSWORD must be an app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=EV Charging Statements
EMAIL_REPLY_TO=
# While set, ALL statement emails go only to this address. Clear to go live.
STATEMENT_TEST_RECIPIENT=
